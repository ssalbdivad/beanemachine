{
  "name": "beanemachine",
  "version": "0.1.0",
  "description": "Fantasy league scoring configuration for the Mrs. Met's Harem lineup optimizer",
  "type": "module",
  "scripts": {
    "dev": "nub run dev:api & vite",
    "dev:api": "nub watch src/server.ts",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "nub src/server.ts",
    "import": "nub src/cli.ts",
    "test": "node test/engine.mjs && node test/leagues.mjs && node test/trade.mjs && node test/auto.mjs && node test/ui.mjs && node test/board.mjs && node test/trade-ui.mjs",
    "check": "tsc --noEmit",
    "refresh": "node src/refresh.ts",
    "test:board": "node test/board.mjs",
    "test:engine": "node test/engine.mjs",
    "backtest": "node src/backtest/run.ts",
    "tune": "node src/backtest/tune.ts",
    "evaluate": "node src/backtest/evaluate.ts",
    "test:static": "node test/static.mjs",
    "auto": "node src/auto/run.ts",
    "auto:login": "node src/auto/run.ts --login",
    "compete": "node src/backtest/compete.ts",
    "test:compete": "node test/compete.mjs",
    "verdict": "node src/backtest/verdict.ts",
    "test:leagues": "node test/leagues.mjs",
    "test:trade": "node test/trade.mjs",
    "test:auto": "node test/auto.mjs",
    "test:trade-ui": "node test/trade-ui.mjs"
  },
  "dependencies": {
    "@hono/arktype-validator": "^2.0.1",
    "@hono/node-server": "^2.1.1",
    "@tanstack/react-form": "^1.33.5",
    "arktype": "^2.2.3",
    "hono": "^4.13.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright-core": "^1.62.1",
    "typescript": "^5.7.2",
    "vite": "^8.2.2"
  }
}
