# Where the API lives, baked into the client at build time.
#
# Leave it unset for local work: `npx vite` proxies /api to `node src/server.ts` on
# the same origin, which is what every test run uses.
#
# Set it for the deployed site. It is what turns "run a command in a terminal" into
# "paste your league URL" for Yahoo, which sends no CORS headers and so cannot be
# read by any browser. Whatever you point it at must list this site in
# ALLOWED_ORIGINS in src/api.ts.
#
# VITE_API_BASE=https://beanemachine-api.vercel.app
