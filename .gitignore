# generated at build time from scoring.json
# regenerable logo exploration output (run logo/round*.mjs to rebuild)
*.tmp
.audit/
.perf/
data/backtest-cache/
data/yahoo-session.json
dist/
logo/.preview.html
logo/candidates*.json
logo/pick.html
logo/pick.png
logo/sheet*.html
logo/sheet*.png
node_modules/
public/snapshot.json

# scratch screenshots taken while working on the UI. The wildcard is the point:
# `git add -A` swept crop.png and then ph.png into commits on the same afternoon,
# and naming them one at a time only ever catches the last one.
*.png
!src/**/*.png
!public/**/*.png

# built by `prepare` on install; not a source artifact
dist-cli/
.vercel

# scratch scripts written while working on the UI; never source.
# `*.tmp.mjs` earns its own line the way `*.png` did: `flow.tmp.mjs` was committed on
# 2026-09-11 because `.*.mjs` wants a LEADING dot, `probe*.mjs` wants that exact prefix,
# and `*.tmp` wants the extension to BE .tmp — three patterns, none of which matched a
# one-off Playwright probe named the obvious way. Measured: `git check-ignore -v
# flow.tmp.mjs` returned no match, and the file shipped to Vercel for four commits.
.*.mjs
probe*.mjs
*.tmp.mjs
dist-ext

# Built by extension/build.mjs and copied here so the site can hand it to a reader.
# A build artifact in the tree is a build artifact that goes stale.
public/beanemachine-*.zip
# The signed add-on Mozilla hands back, and its copy in public/. A build artifact in the
# tree is a build artifact that goes stale, and this one is also a signature over a
# particular build — committing it would let the repo and the file it claims drift.
public/beanemachine-*.xpi
extension/signed/

# Rendered from extension/PRIVACY.md by extension/privacy-page.mjs at build time. One source,
# and the page a store reviewer opens cannot drift from the file the add-on ships beside.
public/privacy/
